# Copy to terraform.tfvars (gitignored) and adjust for your environment.
# Every value below is optional — omitting a variable falls back to the
# default already set for prod in variables.tf. Uncomment and edit only
# what you need to change.

# aws_region      = "eu-west-2"
# cluster_name    = "logging-eks"
# cluster_version = "1.34"
# vpc_cidr        = "10.20.0.0/16"
# azs             = ["eu-west-2a", "eu-west-2b", "eu-west-2c"]

# single_nat_gateway = false   # keep false for prod — see the comment on this variable in variables.tf

# es_node_instance_type      = "r6i.xlarge"
# general_node_instance_type = "m6i.large"

# es_data_node_desired_count   = 3
# es_master_node_desired_count = 3
# general_node_desired_count   = 3

# S3 bucket names are globally unique across ALL AWS accounts — confirm
# this isn't already taken before `terraform apply`.
# snapshot_bucket_name    = "qyon-logging-es-snapshots"
# snapshot_retention_days = 90

# domain_name now correctly propagates into every Ingress/Certificate
# hostname automatically — this used to require also editing a separate
# Kustomize overlay file by hand; that whole layer has been retired in
# favor of Terraform-native resources, so this single variable is the
# only place this needs to change now.
# domain_name = "logging.qyonlimited.com"

# tags = {
#   Project     = "enterprise-k8s-logging"
#   ManagedBy   = "terraform"
#   Environment = "prod"
#   Owner       = "Qyon Limited"
# }

# elasticsearch = {
#   master_count       = 3
#   master_storage_gb  = 30
#   master_cpu_request = "1"
#   master_cpu_limit   = "2"
#   master_memory      = "4Gi"
#   master_heap        = "2g"
#   data_count         = 3
#   data_storage_gb    = 1000
#   data_cpu_request   = "2"
#   data_cpu_limit     = "4"
#   data_memory        = "8Gi"
#   data_heap          = "4g"
# }

# kibana = {
#   replicas       = 2
#   cpu_request    = "500m"
#   cpu_limit      = "1"
#   memory_request = "1Gi"
#   memory_limit   = "2Gi"
# }

# order_api = {
#   replicas       = 3
#   cpu_request    = "100m"
#   cpu_limit      = "500m"
#   memory_request = "128Mi"
#   memory_limit   = "256Mi"
#   image_tag      = "v1.0.0"   # pin to a real release tag — never ":latest" in prod
# }

# slm_expire_after       = "90d"
# alert_email            = "devops@qyonlimited.com"
# enable_service_monitor = false   # set true only if kube-prometheus-stack is already deployed in this cluster

# REQUIRED, no default — get it with:
#   aws route53 list-hosted-zones-by-name --dns-name qyonlimited.com --query "HostedZones[0].Id" --output text
route53_hosted_zone_id = "Z09019271I4E7S51C7UCE"
