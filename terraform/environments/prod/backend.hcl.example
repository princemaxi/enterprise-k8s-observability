# Copy this file to backend.hcl (gitignored) and fill in real values, then:
#   terraform init -backend-config=backend.hcl
#
# Reuses the same state-bucket/lock-table pattern as tooling-app-eks —
# create these once (or reuse existing ones) before the first `init`:
#   aws s3api create-bucket --bucket qyon-terraform-state --region eu-west-2 \
#     --create-bucket-configuration LocationConstraint=eu-west-2
#   aws s3api put-bucket-versioning --bucket qyon-terraform-state \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name qyon-terraform-locks \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST

bucket         = "qyon-terraform-state"
key            = "enterprise-k8s-logging/prod/terraform.tfstate"
region         = "eu-west-2"
dynamodb_table = "qyon-terraform-locks"
encrypt        = true
